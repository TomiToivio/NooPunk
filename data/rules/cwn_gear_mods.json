    }
  },
  "crafting": {
    "weeks_per_minimum_skill_level": 1,
    "assistant_min_fix": 0,
    "assistant_time_divisor": 2,
    "obsessive_time_divisor": 2,
    "prebuilt_install_days": 1,
    "workshop_rent_per_day": 500,
    "workshop_purchase": 20000,
    "build_time_days": {
      "vehicle": 30,
      "portable_complex_device": 7
    },
    "quality": {
      "jury_rigged": {
        "time_divisor": 2,
        "parts_percent_of_market": 25,
        "counts_as_mod": 0,
        "stops_after_hours_without_maintenance": 24,
        "further_modding": false
      },
      "normal": {
        "time_divisor": 1,
        "parts_percent_of_market": 100,
        "salvage_allowed": false
      },
      "mastercrafted": {
        "time_multiplier": 2,
        "parts_percent_of_market": 1000,
        "first_mod_needs_no_maintenance": true
      }
    },
    "consumables_must_be_normal": true,
    "$comment": "Jury-rigged gear counts as a mod requiring Fix-0 to maintain, and a mod going 24 h without maintenance stops working."
  },
  "maintenance": {
    "score_formula": "INT modifier + CON modifier + 3 * Fix skill",
    "full_time_multiplier": 2,
    "lapse_hours_mod_stops": 24,
    "lapse_days_item_stops": 7,
    "backlog_clear_hours": 1,
    "must_have_build_skill": true
  },
