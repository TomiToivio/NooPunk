  "version": 1,
  "issue": "https://github.com/TomiToivio/NooPunk/issues/564",
  "source": {
    "system": "Cities Without Number",
    "edition": "Deluxe, 2023-08-11",
    "licence": "CC0",
    "sections": {
      "weapon_mods": "gear-vehicles-cyberware/weapons/weapon-mods/",
      "armor_mods": "gear-vehicles-cyberware/armor/armor-mods/",
