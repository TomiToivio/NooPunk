{
 "$comment": "Permanent rules foundation for NooPunk (#1006). Machine-readable companion to docs/rules/RULES_CONSTITUTION.md, which is authoritative if they disagree. Purpose: make it impossible to add a rules source, or change a source's role, without a test noticing.",
 "format": "noopunk.rules.constitution",
 "version": 1,
 "issue": "https://github.com/TomiToivio/NooPunk/issues/1006",
 "precedence": [
  "CWN",
  "SWN",
  "WWN",
  "AWN"
 ],
 "minimum_playable": [
  "CWN",
  "SWN"
 ],
 "layers": [
  "core",
  "module",
  "mod"
 ],
 "prohibitions": [
  "redesign_core",
  "replace_attributes",
  "rewrite_skill_mechanics",
  "simplify_rules",
  "silent_behaviour_change",
  "fork_rule_into_mod"
 ],
 "sources": {
  "CWN": {
   "role": "core",
   "status": "locked",
   "licence": "CC0 (SRD)",
   "licence_status": "verified",
   "provides": [
    "attributes",
    "skills",
    "advancement",
    "combat",
    "saves",
    "equipment",
    "resolution"
   ]
  },
  "SWN": {
   "role": "module",
   "status": "adopted",
   "licence": "SRD — not yet verified in this repository",
   "licence_status": "unverified",
   "provides": [
    "psionics"
   ]
  },
  "WWN": {
   "role": "mod",
   "status": "optional",
   "licence": "CC0 (SRD)",
   "licence_status": "verified",
   "provides": []
  },
  "AWN": {
   "role": "mod",
   "status": "optional",
   "licence": "SRD — not yet verified in this repository",
   "licence_status": "unverified",
   "provides": []
  }
 },
 "module_tiers": {
  "$comment": "Which tier each file under src/rules belongs to. The constitution above is about sources (CWN/SWN/WWN/AWN) and roles; this is the same decision expressed where it can be checked against the code tree. tools/rules_constitution_audit.py --check fails if a module is unclassified, duplicated or missing, or if a cwn-core module imports a noopunk-mod one; tests/test_rules_constitution_modules.py additionally runs the baseline with every noopunk-mod module blocked.",
  "tier_vocabulary": {
   "cwn-core": "Cities Without Number, as written. The baseline.",
   "swn-companion": "Stars Without Number, imported whole-procedure. Psionics is the essential companion.",
   "optional-source": "WWN / AWN, opt-in, one procedure, named in the module docstring.",
   "noopunk-mod": "Original NoöPunk overlays: they read core state and add narrative state, never core resolution.",
   "infrastructure": "Boundary, tag vocabulary and catalogues; not rules.",
   "experimental": "Prototypes and labs that are NOT canonical and not part of play.",
   "legacy": "Retired code kept for import compatibility. Never authoritative."
  },
  "baseline": "cwn-core",
  "overlay": "noopunk-mod",
  "vanilla_minimum": [
   "cwn-core",
   "swn-companion"
  ],
