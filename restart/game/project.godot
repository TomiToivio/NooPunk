;
; NoöPunk restart — minimal top-down starter.
; Deliberately empty of rules: no stats, skills, combat, inventory, dialogue or AI. The paired
; rulebook is restart/rulebook/RULEBOOK.md; rules arrive one at a time and are implemented here.

config_version=5

[application]

config/name="NoöPunk (restart)"
config/description="Minimal top-down starter for the NoöPunk restart. One room, one player, movement."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"

[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}

[rendering]

renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.09, 1)
