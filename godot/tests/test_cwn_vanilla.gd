## Vanilla CWN coverage — attack modifiers, chases, cyberware operations, mission time.
##
## Each row is a rule from the SRD that a referee would otherwise apply from memory.
extends RefCounted

const AM := preload("res://godot/core/cwn_attack_modifiers.gd")
const CH := preload("res://godot/core/cwn_chases.gd")
const CW := preload("res://godot/core/cwn_cyberware_ops.gd")
const MT := preload("res://godot/core/cwn_mission_time.gd")
const GM := preload("res://godot/core/cwn_gear_mods.gd")
const CO := preload("res://godot/core/cwn_contacts.gd")
const SC := preload("res://godot/core/cwn_social_costs.gd")
const CC := preload("res://godot/core/cwn_cyberware_complications.gd")


func _eq(name: String, actual: Variant, expected: Variant) -> Array:
	return [name, actual == expected, "got %s; expected %s" % [str(actual), str(expected)]]


func run() -> Array:
	var rows: Array = []

	# ---- attack modifiers -------------------------------------------------------------------
	rows.append(_eq("half cover is -2", AM.modifier(["target_half_cover"])["modifier"], -2))
	rows.append(_eq("almost full cover is -4", AM.modifier(["target_almost_full_cover"])["modifier"], -4))
	rows.append(_eq("prone adjacent target is +2", AM.modifier(["target_prone_adjacent"])["modifier"], 2))
	rows.append(_eq("modifiers stack", AM.modifier(["target_half_cover", "beyond_normal_range"])["modifier"], -4))
	rows.append(_eq("two-handed gun in melee is impossible", AM.modifier(["two_handed_gun_in_melee"])["ok"], false))
	rows.append(_eq("unknown position is impossible", AM.is_impossible("target_unseen_position_unknown"), true))
	rows.append(_eq("typo is not a silent zero", AM.modifier(["target_half_covr"])["ok"], false))
	rows.append(_eq("impossible reports why", AM.modifier(["two_handed_gun_in_melee"])["blocked"].size(), 1))

	# ---- chases ----------------------------------------------------------------------------
	rows.append(_eq("pace is the best exert total", CH.foot_pace(9, 0), 9))
	rows.append(_eq("hindrance adds +1 each", CH.foot_pace(9, 2), 11))
	rows.append(_eq("hindrance caps at +3", CH.foot_pace(9, 5), 12))
	rows.append(_eq("a botched hindrance is -1", CH.foot_pace(9, 2, 1), 10))
	rows.append(_eq("no head start is +2", CH.pursuit_modifier(["no_head_start"])["modifier"], 2))
	rows.append(_eq("a round of head start is +1", CH.pursuit_modifier(["one_round_head_start"])["modifier"], 1))
	rows.append(_eq("over a minute of head start is -2", CH.pursuit_modifier(["more_than_a_minute_head_start"])["modifier"], -2))
	rows.append(_eq("terrain is clamped to +2", CH.pursuit_modifier([], 5)["modifier"], 2))
	rows.append(_eq("terrain is clamped to -2", CH.pursuit_modifier([], -5)["modifier"], -2))
	rows.append(_eq("beating the pace catches", CH.resolve(10, 11)["caught"], true))
	rows.append(_eq("a tie escapes", CH.resolve(10, 10)["caught"], false))
	rows.append(_eq("rolling under the pace escapes", CH.resolve(10, 8)["escaped"], true))
	rows.append(_eq("foot chase applies pursuit modifiers", CH.foot(10, 10, 0, 0, ["enraged"])["caught"], true))
	rows.append(_eq("foot chase can also miss", CH.foot(14, 10, 0, 0, ["more_than_a_minute_head_start"])["escaped"], true))
	rows.append(_eq("vehicle chase needs a pursuer", CH.vehicle(10, [])["ok"], false))
	rows.append(_eq("a pursuer at the pace catches", CH.vehicle(10, [10])["caught_by"], [true]))
	rows.append(_eq("a slower pursuer drops out", CH.vehicle(14, [12])["caught_by"], [false]))
	rows.append(_eq("one of two pursuers can catch", CH.vehicle(12, [11, 13])["any_caught"], true))

	# ---- cyberware operations --------------------------------------------------------------
	rows.append(_eq("zero strain costs $100 at difficulty 7", CW.install_terms(0.0)["difficulty"], 7))
	rows.append(_eq("half a point is still the $500 tier", CW.install_terms(0.5)["cost"], 500))
	rows.append(_eq("one point is the $2,500 tier", CW.install_terms(1.0)["cost"], 2500))
	rows.append(_eq("three points is the $12,500 tier", CW.install_terms(3.0)["difficulty"], 11))
	rows.append(_eq("heavy cyber is the $50,000 tier", CW.install_terms(4.0)["cost"], 50000))
	rows.append(_eq("negative strain is refused", CW.install_terms(-1.0)["ok"], false))
	rows.append(_eq("theatre 3 with sterile room is +3", CW.surgery_modifier(3, "sterile", false)["modifier"], 3))
	rows.append(_eq("lacking a room is -1", CW.surgery_modifier(0, "lacks_room", false)["modifier"], -1))
	rows.append(_eq("new cyber adds +1", CW.surgery_modifier(1, "clean_room", true)["modifier"], 1))
	rows.append(_eq("unknown room is refused", CW.surgery_modifier(1, "garage", false)["ok"], false))
	rows.append(_eq("meeting the difficulty succeeds", CW.resolve_installation(10, 10)["outcome"], "success"))
	rows.append(_eq("failing by one still succeeds", CW.resolve_installation(9, 10)["outcome"], "success_with_complication"))
	rows.append(_eq("failing by two still succeeds", CW.resolve_installation(8, 10)["outcome"], "success_with_complication"))
	rows.append(_eq("failing by three fails", CW.resolve_installation(7, 10)["outcome"], "failure"))
	rows.append(_eq("a bad failure maximises strain", CW.resolve_installation(7, 10)["system_strain_maximised"], true))
	rows.append(_eq("a bad failure leaves 1 hit point", CW.resolve_installation(7, 10)["hit_points"], 1))
	rows.append(_eq("the cyber survives as used", CW.resolve_installation(7, 10)["cyber_becomes_used"], true))
	rows.append(_eq("safe removal takes an hour", CW.removal_terms(10)["minutes"], 60))
	rows.append(_eq("unconcerned removal takes ten minutes", CW.removal_terms(10, false)["minutes"], 10))
	rows.append(_eq("removal success keeps the implant", CW.resolve_removal(10, 10)["implant_intact"], true))
	rows.append(_eq("removal failure ruins the implant", CW.resolve_removal(9, 10)["implant_intact"], false))
	rows.append(_eq("the patient stays healthy either way", CW.resolve_removal(9, 10)["patient_healthy"], true))
	rows.append(_eq("strain is lost on removal", CW.resolve_removal(9, 10)["system_strain_removed"], true))
	rows.append(_eq("two-day-old corpse is salvageable", CW.resolve_salvage(10, 48.0)["recovered"], false))
	rows.append(_eq("fresh corpse can be salvaged", CW.resolve_salvage(10, 2.0)["recovered"], true))
	rows.append(_eq("successful reuse leaves used cyber", CW.resolve_reuse(10)["state"], "used"))
	rows.append(_eq("failed reuse is secondhand", CW.resolve_reuse(9)["state"], "secondhand"))
	rows.append(_eq("alienation rounds strain up", CW.alienation_gain(0.5), 1))
	rows.append(_eq("nerve cyber adds two", CW.alienation_gain(1.0, true), 3))
	rows.append(_eq("maximum is Wisdom plus syndromes", CW.max_alienation(10, ["distant"])["maximum"], 13))
	rows.append(_eq("the same syndrome cannot be taken twice", CW.max_alienation(10, ["distant", "distant"])["ok"], false))
	rows.append(_eq("an unknown syndrome is reported", CW.max_alienation(10, ["sparkly"])["ok"], false))
	rows.append(_eq("a low roll against high alienation gains", CW.alienation_check(3, 6)["gains_point"], true))
	rows.append(_eq("a high roll does not", CW.alienation_check(15, 6)["gains_point"], false))
	rows.append(_eq("therapy lowers by one", CW.therapy_week(5, 2), 4))
	rows.append(_eq("therapy cannot go below the permanent amount", CW.therapy_week(2, 2), 2))
	rows.append(_eq("above maximum is psychosis", CW.is_psychotic(11, 10), true))
	rows.append(_eq("at maximum is not psychosis", CW.is_psychotic(10, 10), false))

	# ---- mission time ----------------------------------------------------------------------
	rows.append(_eq("six seconds to a round", MT.ROUND_SECONDS, 6))
	rows.append(_eq("one hundred rounds to a scene", MT.rounds_in_a_scene(), 100))
	rows.append(_eq("two rounds is a fifth of a minute", MT.rounds_to_minutes(2), 0.2))
	rows.append(_eq("ten minutes is a hundred rounds", MT.rounds_in_minutes(10), 100))
	var clock := MT.new()
	rows.append(_eq("mission time starts at zero", clock.minute, 0))
	clock.advance(1)
	rows.append(_eq("an action costs a minute", clock.minute, 1))
	rows.append(_eq("a short action does not refresh the scene", clock.advance(1)["scene_refreshed"], false))
	var long_action := clock.advance(10)
	rows.append(_eq("ten minutes starts a new scene", long_action["scene_refreshed"], true))
	rows.append(_eq("the clock reports the new scene", clock.scene, 1))
	rows.append(_eq("minutes into the scene reset", clock.minutes_into_scene(), 2))
	rows.append(_eq("time does not run backwards", clock.advance(-5)["ok"], false))
	var jump := clock.advance(25)
	rows.append(_eq("a long jump can cross several scenes", jump["scenes_elapsed"] >= 2, true))

	# ---- crafting and gear mods ------------------------------------------------------------
	rows.append(_eq("maintenance score is INT+CON+3xFix", GM.maintenance_score(1, 1, 2)["score"], 8))
	rows.append(_eq("full-time maintenance doubles", GM.maintenance_score(1, 1, 2, true)["score"], 16))
	rows.append(_eq("a negative score is none", GM.maintenance_score(-2, -1, 0)["score"], 0))
	rows.append(_eq("untrained Fix cannot maintain", GM.maintenance_score(0, 0, -1)["ok"], false))
	rows.append(_eq("autotargeting needs Fix-1", GM.weapon_mod("autotargeting")["min_fix"], 1))
	rows.append(_eq("an unknown mod is not found", GM.weapon_mod("phase_plasma").is_empty(), true))
	rows.append(_eq("a Fix-1 mod takes a week", GM.install_weeks(GM.weapon_mod("autotargeting")), 1))
	rows.append(_eq("an assistant halves nothing below one week", GM.install_weeks(GM.weapon_mod("autotargeting"), true), 1))
	rows.append(_eq("a working mod has not lapsed", GM.maintenance_lapse(0.0), "working"))
	rows.append(_eq("24 hours without maintenance kills the mod", GM.maintenance_lapse(24.0), "mod_dead"))
	rows.append(_eq("seven days kills the item", GM.maintenance_lapse(168.0), "item_dead"))
	rows.append(_eq("a normal build costs full parts", GM.craft_plan("normal", 1000)["parts_cost"], 1000))
	rows.append(_eq("normal build takes a week", GM.craft_plan("normal", 1000)["days"], 7))
	rows.append(_eq("a vehicle build takes a month", GM.craft_plan("normal", 1000, true)["days"], 30))
	rows.append(_eq("an unknown quality is refused", GM.craft_plan("legendary", 1000)["ok"], false))
	rows.append(_eq("factory mods cost five times the mod", GM.factory_price(1000, 200)["price"], 2000))
	rows.append(_eq("each component doubles the price", GM.factory_price(1000, 200, 1)["price"], 4000))
	rows.append(_eq("negative cost is refused", GM.factory_price(-1, 0)["ok"], false))
	var idle: Dictionary = GM.apply_weapon_mods(["autotargeting"], "firearm", false)
	rows.append(_eq("a connection mod without a link is inactive", idle["inactive"].size(), 1))
	rows.append(_eq("an inactive mod contributes nothing", idle["hit_bonus"], 0))
	var live: Dictionary = GM.apply_weapon_mods(["autotargeting"], "firearm", true)
	rows.append(_eq("with a gunlink it contributes +1", live["hit_bonus"], 1))
	rows.append(_eq("the same mod cannot be applied twice", GM.apply_weapon_mods(["autotargeting", "autotargeting"], "firearm", true)["ok"], false))
	rows.append(_eq("an unknown weapon mod is refused", GM.apply_weapon_mods(["phaser"], "firearm", true)["ok"], false))
	rows.append(_eq("a firearm mod does not fit a melee weapon", GM.apply_weapon_mods(["autotargeting"], "melee", true)["ok"], false))

	# ---- contacts --------------------------------------------------------------------------
	rows.append(_eq("a new PC may take two acquaintances", CO.starting_set("two_acquaintances")["contacts"].size(), 2))
	rows.append(_eq("a new PC may take one friend instead", CO.starting_set("one_friend")["contacts"][0]["level"], "friend"))
	rows.append(_eq("any other starting choice is refused", CO.starting_set("three_friends")["ok"], false))
	var ok_contact := {"name": "Mira", "profession": "street cyberdoc", "history": "patched me up after the Kallas job", "level": "acquaintance"}
	rows.append(_eq("a complete contact validates", CO.validate(ok_contact)["ok"], true))
	var partial_contact := {"name": "Mira", "profession": "", "history": "", "level": "friend"}
	rows.append(_eq("a contact without a profession is incomplete", CO.validate(partial_contact)["missing"], ["profession", "history"]))
	rows.append(_eq("an unknown level is incomplete", CO.validate({"name": "X", "profession": "y", "history": "z", "level": "buddy"})["missing"], ["level"]))
	rows.append(_eq("an acquaintance does small favors", CO.can_ask("acquaintance", false, false)["allowed"], true))
	rows.append(_eq("an acquaintance refuses real risk", CO.can_ask("acquaintance", true, false)["allowed"], false))
	rows.append(_eq("an acquaintance refuses significant expense", CO.can_ask("acquaintance", false, true)["allowed"], false))
	rows.append(_eq("a friend takes on risk", CO.can_ask("friend", true, true)["allowed"], true))
	rows.append(_eq("a refusal explains itself", CO.can_ask("acquaintance", true)["refusal"].is_empty(), false))
	rows.append(_eq("contacts never join a mission", CO.can_join_mission(), false))
	rows.append(_eq("one call per session", CO.calls_per_session(), 1))
	rows.append(_eq("burning a friend leaves an acquaintance", CO.downgrade("friend"), "acquaintance"))
	rows.append(_eq("burning an acquaintance loses them", CO.downgrade("acquaintance"), "none"))
	rows.append(_eq("trust upgrades an acquaintance", CO.upgrade("acquaintance"), "friend"))

	# ---- lifestyles, wages, bribes, chems ---------------------------------------------------
	rows.append(_eq("middle-class life costs $1,000", SC.lifestyle_cost("middle_class")["cost_per_month"], 1000))
	rows.append(_eq("squatting costs no cash but -2 strain", SC.lifestyle_cost("squatter")["strain_modifier"], -2))
	rows.append(_eq("luxury grants +2 maximum strain", SC.lifestyle_cost("luxury")["strain_modifier"], 2))
	rows.append(_eq("an unknown lifestyle is refused", SC.lifestyle_cost("penthouse")["ok"], false))
	rows.append(_eq("an elite bodyguard earns $500 a day", SC.wage("elite_bodyguard")["daily"], 500))
	rows.append(_eq("a minor favor from a manager costs $500", SC.bribe_cost("corp_middle_manager", "look_other_way_minor")["cost"], 500))
	rows.append(_eq("a job-threatening favor is flagged serious", SC.bribe_cost("corp_middle_manager", "favor_might_get_fired")["serious_risk"], true))
	rows.append(_eq("avalanche needs Heal-0", SC.drug("avalanche")["min_heal"], 0))
	rows.append(_eq("sand needs no medical skill", SC.drug("sand")["min_heal"], -1))
	rows.append(_eq("reset needs a contact", SC.drug("reset")["contact_required"], true))
	rows.append(_eq("panacea cannot be given untrained", SC.can_administer(0, "panacea")["allowed"], false))
	rows.append(_eq("anyone can administer sand", SC.can_administer(0, "sand")["allowed"], true))
	rows.append(_eq("a chem within Strain grants its benefit", SC.strain_gate(8, 10, 2)["benefit"], true))
	rows.append(_eq("overflowing Strain denies the benefit", SC.strain_gate(9, 10, 2)["benefit"], false))
	rows.append(_eq("overflowing Strain still applies harm", SC.strain_gate(9, 10, 2)["harmful_effects_still_apply"], true))

	# ---- implant complications -------------------------------------------------------------
	rows.append(_eq("the complication table has twelve rows", CC.TABLE.size(), 12))
	rows.append(_eq("roll 2 is Inefficient", CC.complication(2)["id"], "inefficient"))
	rows.append(_eq("Inefficient adds half a Strain point", CC.complication(2)["extra_strain"], 0.5))
	rows.append(_eq("roll 8 adds a point with a sibling implant", CC.extra_strain(8, true), 1.0))
	rows.append(_eq("roll 8 adds nothing alone", CC.extra_strain(8, false), 0.0))
	rows.append(_eq("a non-applicable roll becomes 12", CC.complication(3, false)["used"], 12))
	rows.append(_eq("a d13 roll is refused", CC.complication(13)["ok"], false))

	return rows
