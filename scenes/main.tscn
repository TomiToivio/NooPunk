[gd_scene format=3]

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Stack" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 12
alignment = 1

[node name="Title" type="Label" parent="Center/Stack"]
layout_mode = 2
text = "NoöPunk"
horizontal_alignment = 1

[node name="Status" type="Label" parent="Center/Stack"]
layout_mode = 2
text = "RPG foundation scaffold"
horizontal_alignment = 1

[node name="Note" type="Label" parent="Center/Stack"]
layout_mode = 2
text = "Rules and world systems are intentionally unspecified."
horizontal_alignment = 1
